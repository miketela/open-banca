# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Optional: Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Optional, for OpenAI models. Format: sk-proj-...
GOOGLE_API_KEY="your_google_api_key_here"             # Optional, for Google Gemini models.
MISTRAL_API_KEY="your_mistral_key_here"               # Optional, for Mistral AI models.
XAI_API_KEY="YOUR_XAI_KEY_HERE"                       # Optional, for xAI AI models.
GROQ_API_KEY="YOUR_GROQ_KEY_HERE"                     # Optional, for Groq models.
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY_HERE"         # Optional, for OpenRouter models.
AZURE_OPENAI_API_KEY="your_azure_key_here"            # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY="your_ollama_api_key_here"             # Optional: For remote Ollama servers that require authentication.
GITHUB_API_KEY="your_github_api_key_here"             # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...

# =============================================================================
# open-banca — docker-compose stack configuration
# Copiar a .env y completar los valores CHANGE_ME antes de `docker compose up`.
# Ver docs/05-operations/deployment.md § Primer arranque.
# =============================================================================

# --- REQUIRED (la API no arranca sin estos) ---

# Passphrase maestra para cifrado AES-GCM de credenciales bancarias (sqlcipher).
# Security Critical Rule #6: SOLO via env, nunca en config files ni logs.
# Generar: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OPEN_BANCA_MASTER_PASSPHRASE=CHANGE_ME_use_python_secrets_token_urlsafe_32

# HMAC secret para firma de webhooks.
# Generar: python3 -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_HMAC_SECRET=CHANGE_ME_use_python_secrets_token_hex_32

# API key para autenticación de clientes.
# Generar: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_ME_use_python_secrets_token_urlsafe_32

# Password PostgreSQL para Temporal.
# Generar: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
TEMPORAL_DB_PASSWORD=CHANGE_ME_use_python_secrets_token_urlsafe_24

# --- OPTIONAL (con defaults razonables) ---

DEEPSEEK_API_KEY=
OPEN_BANCA_API_PORT=8080
OPEN_BANCA_ENV=production
TASK_QUEUE=open-banca-main
WORKER_CONCURRENCY=3
SANDBOX_IMAGE=open-banca-sandbox:latest
OTEL_EXPORTER_OTLP_ENDPOINT=
TEMPORAL_UI_PORT=8088
TEMPORAL_UI_CORS_ORIGINS=http://localhost:8088

# --- LANGFUSE (solo si usas --profile langfuse) ---
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_DB_PASSWORD=CHANGE_ME_langfuse_db_password
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_use_python_secrets_token_hex_32
LANGFUSE_SALT=CHANGE_ME_use_python_secrets_token_hex_16
LANGFUSE_URL=http://localhost:3000