{
  "bank_id": "banco_general",
  "version": "1.0.0",
  "schema_version": "1",
  "steps": [
    {
      "step_id": "navigate_homepage",
      "action": "navigate",
      "url": "https://www.bgeneral.com/",
      "wait_until": "domcontentloaded"
    },
    {
      "step_id": "dismiss_cookie_banner",
      "action": "click",
      "selector": "a.cli_action_button",
      "optional": true,
      "force": true
    },
    {
      "step_id": "open_banca_en_linea_dropdown",
      "action": "click",
      "selector": "button.dropbtn",
      "nth": 0
    },
    {
      "step_id": "wait_for_login_widget",
      "action": "wait_for_selector",
      "frame_selector": "#bel-desktop #inbank",
      "selector": "#txtLoginD",
      "state": "attached",
      "timeout_ms": 20000
    },
    {
      "step_id": "fill_username",
      "action": "fill",
      "frame_selector": "#bel-desktop #inbank",
      "selector": "#txtLoginD",
      "value_ref": "<USERNAME>",
      "trigger_blur": true
    },
    {
      "step_id": "submit_username",
      "action": "click",
      "frame_selector": "#bel-desktop #inbank",
      "selector": "button.btningresar"
    },
    {
      "step_id": "navigate_zonasegura_portal",
      "action": "navigate",
      "url": "https://zonasegura.bgeneral.com/web/guest/home#!/login/username?username=<USERNAME>",
      "wait_until": "domcontentloaded"
    },
    {
      "step_id": "wait_for_security_question_page",
      "action": "wait_for_selector",
      "selector": "#answer",
      "state": "attached",
      "timeout_ms": 20000
    },
    {
      "step_id": "answer_security_question_first_job_title",
      "action": "prompt_user",
      "selector": "#answer",
      "question_selector": "p:has-text('?'), [class*='pregunta'], [class*='question']",
      "question_wait_ms": 15000,
      "field_key": "security_q_first_job_title",
      "cache_answers": true,
      "timeout_s": 240
    },
    {
      "step_id": "submit_security_answer",
      "action": "click",
      "selector": "button:has-text('Validar'), button[type=submit]"
    },
    {
      "step_id": "wait_for_password_field",
      "action": "wait_for_selector",
      "selector": "input[type=password]",
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "fill_password",
      "action": "fill",
      "selector": "input[type=password]",
      "value_ref": "<PASSWORD>",
      "trigger_blur": true,
      "sensitive": true
    },
    {
      "step_id": "submit_password",
      "action": "click",
      "selector": "button:has-text('Validar'), button[type=submit], #btn_enter"
    },
    {
      "step_id": "wait_for_dashboard",
      "action": "wait_for_selector",
      "selector": "a[role=menuitem]",
      "state": "visible",
      "timeout_ms": 20000
    },
    {
      "step_id": "navigate_to_dashboard",
      "action": "navigate",
      "url": "https://zonasegura.bgeneral.com/group/guest/dashboard",
      "wait_until": "domcontentloaded"
    },
    {
      "step_id": "open_account_context_menu",
      "action": "click",
      "selector": "[aria-expanded=false] span.account-menu-trigger, div[aria-expanded=false]",
      "nth": 0
    },
    {
      "step_id": "click_ver_movimientos",
      "action": "click",
      "selector": "a[href*='movimientos'], a[href*='detalle-de-cuenta']"
    },
    {
      "step_id": "wait_for_transaction_history",
      "action": "wait_for_selector",
      "selector": "#tabMenu0",
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "click_ultimos_movimientos_tab",
      "action": "click",
      "selector": "#tabMenu0"
    },
    {
      "step_id": "set_date_range_from",
      "action": "fill",
      "selector": "#dateOfTransaction0",
      "value_ref": "<DATE_FROM>"
    },
    {
      "step_id": "set_date_range_to",
      "action": "fill",
      "selector": "#dateOfTransaction1",
      "value_ref": "<DATE_TO>"
    },
    {
      "step_id": "search_transactions",
      "action": "click",
      "selector": "button[type=submit][role=button]"
    },
    {
      "step_id": "wait_for_transactions_loaded",
      "action": "wait_for_selector",
      "selector": "label[aria-expanded]",
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "open_descargar_dropdown",
      "action": "click",
      "selector": "label[aria-expanded] em"
    },
    {
      "step_id": "download_excel",
      "action": "download_file",
      "trigger_selector": "a[href*='Excel'], .dropdown-menu a:nth-child(3)",
      "expected_mime": "application/vnd.ms-excel",
      "expected_extension": "xls",
      "expected_content_type": "application/vnd.ms-excel",
      "selector": "download.xls"
    }
  ]
}