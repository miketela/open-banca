{
  "bank_id": "banco_general",
  "version": "0.0.2",
  "schema_version": "1",
  "signature": null,
  "steps": [
    {
      "step_id": "login_navigate",
      "action": "navigate",
      "url": "https://www.bfranchservice.bancogeneral.com/eBanking4/Login.aspx"
    },
    {
      "step_id": "login_wait_form",
      "action": "wait_for_selector",
      "selector": "[id*='user'], [id*='usuario'], input[type='text']:first-of-type",
      "timeout_ms": 15000
    },
    {
      "step_id": "login_fill_username",
      "action": "fill",
      "selector": "[id*='user'], [id*='usuario'], input[type='text']:first-of-type",
      "value_ref": "personal:username",
      "sensitive": false
    },
    {
      "step_id": "login_fill_password",
      "action": "fill",
      "selector": "[id*='pass'], [id*='clave'], input[type='password']",
      "value_ref": "personal:password",
      "sensitive": true
    },
    {
      "step_id": "login_submit",
      "action": "click",
      "selector": "button[type='submit'], input[type='submit'], [id*='login'], [id*='ingresar']"
    },
    {
      "step_id": "dashboard_wait",
      "action": "wait_for_selector",
      "selector": "[id*='account'], [class*='account'], [id*='cuenta'], [class*='cuenta']",
      "timeout_ms": 20000
    },
    {
      "step_id": "account_savings_navigate",
      "action": "navigate",
      "url": "https://www.bfranchservice.bancogeneral.com/eBanking4/Accounts/Savings",
      "wait_until": "networkidle"
    },
    {
      "step_id": "account_savings_select_date_range",
      "action": "select_date_range",
      "from_selector": "[id*='fecha_inicio'], [id*='from_date'], [name*='from']",
      "to_selector": "[id*='fecha_fin'], [id*='to_date'], [name*='to']",
      "months_back": 6
    },
    {
      "step_id": "account_savings_download",
      "action": "download_file",
      "selector": "a[href*='xls'], a[href*='xlsx'], button[id*='excel'], button[id*='descargar']",
      "expected_content_type": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    },
    {
      "step_id": "account_savings_wait_download",
      "action": "wait_for_download",
      "timeout_ms": 30000
    },
    {
      "step_id": "account_checking_navigate",
      "action": "navigate",
      "url": "https://www.bfranchservice.bancogeneral.com/eBanking4/Accounts/Checking",
      "wait_until": "networkidle"
    },
    {
      "step_id": "account_checking_select_date_range",
      "action": "select_date_range",
      "from_selector": "[id*='fecha_inicio'], [id*='from_date'], [name*='from']",
      "to_selector": "[id*='fecha_fin'], [id*='to_date'], [name*='to']",
      "months_back": 6
    },
    {
      "step_id": "account_checking_download",
      "action": "download_file",
      "selector": "a[href*='xls'], a[href*='xlsx'], button[id*='excel'], button[id*='descargar']",
      "expected_content_type": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    },
    {
      "step_id": "account_checking_wait_download",
      "action": "wait_for_download",
      "timeout_ms": 30000
    },
    {
      "step_id": "account_credit_card_navigate",
      "action": "navigate",
      "url": "https://www.bfranchservice.bancogeneral.com/eBanking4/Cards/CreditCard",
      "wait_until": "networkidle"
    },
    {
      "step_id": "account_credit_card_select_date_range",
      "action": "select_date_range",
      "from_selector": "[id*='fecha_inicio'], [id*='from_date'], [name*='from']",
      "to_selector": "[id*='fecha_fin'], [id*='to_date'], [name*='to']",
      "months_back": 6
    },
    {
      "step_id": "account_credit_card_download",
      "action": "download_file",
      "selector": "a[href*='xls'], a[href*='xlsx'], button[id*='excel'], button[id*='descargar']",
      "expected_content_type": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    },
    {
      "step_id": "account_credit_card_wait_download",
      "action": "wait_for_download",
      "timeout_ms": 30000
    }
  ]
}
