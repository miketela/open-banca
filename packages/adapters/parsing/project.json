{
  "name": "parsing",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/adapters/parsing/src",
  "tags": [
    "scope:parsing",
    "layer:adapter"
  ],
  "implicitDependencies": [
    "application",
    "domain"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run ruff check packages/adapters/parsing",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pyrefly check packages/adapters/parsing/src",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest packages/adapters/parsing/tests -v",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
